generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//modelos
model Usuario {
  id          Int                @id @default(autoincrement())
  nombre      String
  correo      String             @unique
  role        Role               @default(USER)
  password    String
  direccion   String?
  ultimoLogin DateTime?          @default(now())
  //Relaciones 
  pedidos     Pedido[]
  resenas     Resena[]
  historial   HistorialPedidos[]
}

model Imagen {
  id         Int       @id @default(autoincrement())
  ruta       String    @default("image-not-found.jpg")
  //Relaciones
  productoId Int?
  productos  Producto? @relation(fields: [productoId], references: [id])
}

model Producto {
  id                 Int                     @id @default(autoincrement())
  nombre             String
  descripcion        String                  @db.VarChar(500)
  precio             Decimal                 @db.Decimal(10, 2)
  stock              Int                     @default(1) //En inventario
  imagenPrincipal    String                  @default("")
  autor              String?
  fechaCreacion      DateTime                @default(now())
  fechaActualizacion DateTime?               @default(now()) @updatedAt
  //Relaciones
  imagenes           Imagen[]
  personalizado      ProductoPersonalizado[]
  categorias         ProductoCategoria[]
  etiquetas          ProductoEtiqueta[]
  pedidos            PedidoProducto[]
  resenas            Resena[]
  promocionId        Int?
  promocion          Promocion?              @relation(fields: [promocionId], references: [id])
}

model Categoria {
  id          Int                 @id @default(autoincrement())
  descripcion String
  //Relaciones 
  productos   ProductoCategoria[]
  promocionId Int?
  promocion   Promocion?          @relation(fields: [promocionId], references: [id])
}

//Intermedia explicita
model ProductoCategoria {
  productoId  Int
  categoriaId Int
  //Relaciones 
  producto    Producto  @relation(fields: [productoId], references: [id])
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@id([productoId, categoriaId])
}

//Intermedia explicita
model Etiqueta {
  id          Int                @id @default(autoincrement())
  descripcion String
  //Relaciones 
  productos   ProductoEtiqueta[]
}

//Intermedia Explicita
model ProductoEtiqueta {
  productoId Int
  etiquetaId Int
  //Relaciones 
  producto   Producto @relation(fields: [productoId], references: [id])
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id])

  @@id([productoId, etiquetaId])
}

model Pedido {
  id          Int                @id @default(autoincrement())
  fechaPedido DateTime           @default(now())
  //Relaciones 
  usuarioId   Int
  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
  estado      Estado             @default(EN_CARRITO)
  productos   PedidoProducto[]
  historial   HistorialPedidos[]
}

//Intermedia Explicita
model PedidoProducto {
  cantidad        Int
  precioUnitario  Decimal                 @db.Decimal(10, 2)
  subtotal        Decimal                 @db.Decimal(10, 2)
  impuestos       Float                   @default(1.13)
  total           Decimal                 @db.Decimal(10, 2)
  //Relaciones
  pedidoId        Int
  pedido          Pedido                  @relation(fields: [pedidoId], references: [id])
  productoId      Int
  producto        Producto                @relation(fields: [productoId], references: [id])
  personalizadoId Int?
  personalizado   ProductoPersonalizado[]

  @@id([pedidoId, productoId])
}

model ProductoPersonalizado {
  id          Int     @id @default(autoincrement())
  logo        Boolean @default(true) //0-A color, 1-B/N
  precioTotal Decimal @db.Decimal(10, 2)

  // Relaciones
  colorId    Int //llamar al HEX del color
  color      PrecioColor    @relation(fields: [colorId], references: [id])
  materialId Int
  material   PrecioMaterial @relation(fields: [materialId], references: [id])
  tamannoId  Int
  tamanno    PrecioTamanno  @relation(fields: [tamannoId], references: [id])

  //Relacion para integrar en la tabla intermmedia de PedidoProducto
  productoId     Int
  producto       Producto        @relation(fields: [productoId], references: [id])
  pedidoId       Int?
  pedidoProducto PedidoProducto? @relation(fields: [pedidoId, productoId], references: [pedidoId, productoId])
}

model PrecioMaterial {
  id            Int                     @id @default(autoincrement())
  nombre        String //Para la UI
  precio        Decimal                 @db.Decimal(10, 2)
  personalizado ProductoPersonalizado[]
}

model PrecioTamanno {
  id            Int                     @id @default(autoincrement())
  nombre        String //Para la UI
  precio        Decimal                 @db.Decimal(10, 2)
  personalizado ProductoPersonalizado[]
}

model PrecioColor {
  id            Int                     @id @default(autoincrement())
  hexa          String
  nombre        String //Para la UI
  precio        Decimal                 @db.Decimal(10, 2)
  personalizado ProductoPersonalizado[]
}

model Resena {
  id          Int       @id @default(autoincrement())
  valoracion  Int //1 a 5 estrellas
  comentario  String?
  fecha       DateTime  @default(now())
  moderada    Boolean   @default(false) //T-Ocultar F-Visible
  observacion String? //Motivo de la censura
  //Relaciones 
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  productoId  Int
  producto    Producto  @relation(fields: [productoId], references: [id])
  reportes    Reporte[]
}

model Reporte {
  id           Int    @id @default(autoincrement())
  reportadaPor String @default("Anonimo")
  motivo       String @db.VarChar(500)
  //Relaciones
  reseñaId    Int
  resena       Resena @relation(fields: [reseñaId], references: [id])
}

//Revisar si pueden haber varias promos para el mismo producto?
model Promocion {
  id            Int           @id @default(autoincrement())
  nombre        String
  descuento     Decimal       @db.Decimal(10, 2) // 10% (Precio producto x 0.10 ) o 5000.00 (Precio fijo)
  fechaInicio   DateTime //Rango de fechas
  fechaFin      DateTime //para las promociones
  tipoDescuento TipoDescuento @default(PORCENTAJE)
  tipoPromocion TipoPromocion @default(POR_PRODUCTO)
  estadoPromo   EstadoPromo   @default(PENDIENTE)
  //Relaciones
  productos     Producto[]
  categorias    Categoria[]
}

//REVISAR HISTORIAL PEDIDOS, A VER SI PUEDE SER 1:M O N:M
model HistorialPedidos {
  id     Int      @id @default(autoincrement())
  estado Estado // Enum con los valores de estado
  fecha  DateTime @default(now())

  //relaciones
  actualizadoPorId Int
  actualizadoPor   Usuario @relation(fields: [actualizadoPorId], references: [id])
  pedidoId         Int
  pedido           Pedido  @relation(fields: [pedidoId], references: [id])
}

enum Role {
  USER //Por defecto
  ADMIN
}

enum Estado {
  EN_CARRITO //Por defecto
  PAGADO
  EN_ENTREGA
  COMPLETADO
}

enum EstadoPromo {
  PENDIENTE //Por defecto
  APLICADA
  VIGENTE
}

enum TipoDescuento {
  MONTO_FIJO //Por defecto
  PORCENTAJE
}

enum TipoPromocion {
  POR_PRODUCTO //Por defecto
  POR_CATEGORIA
}
